[Desktop Entry]
Type=Application
Version=1.0
Name=Media Explorer
GenericName=Video File Browser
Comment=Browse, search, manage, and play videos on local and mapped drives
TryExec=@EXEC@
Exec=env QT_QPA_PLATFORM=xcb "@EXEC@"
Icon=@ICON@
Terminal=false
Categories=AudioVideo;Video;
Keywords=video;media;vlc;files;playlist;
StartupNotify=true
